{
  "name": "@avenra/ui",
  "version": "0.1.0",
  "private": false,
  "description": "React component library for the Avenra design system.",
  "license": "MIT",
  "homepage": "https://github.com/hj01857655/AvenraUI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hj01857655/AvenraUI.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui",
    "avenra"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts src/components",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  }
}
